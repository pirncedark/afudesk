{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AfuDesk izinli siteler",
  "type": "object",
  "required": ["siteler"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "siteler": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "url", "permissions", "loggedIn"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "url": { "type": "string", "minLength": 1 },
          "permissions": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "enum": ["oku", "giriş", "form-doldur", "hassas"] }
          },
          "loggedIn": {
            "type": "object", "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "selector": { "type": "string", "minLength": 1 },
              "url": { "type": "string", "minLength": 1 }
            }
          },
          "googleButtonSelector": { "type": "string", "minLength": 1 },
          "accountSelector": { "type": "string", "minLength": 1 },
          "stopSelectors": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "consent": { "type": "string", "minLength": 1 },
              "account-creation": { "type": "string", "minLength": 1 },
              "captcha": { "type": "string", "minLength": 1 },
              "2fa": { "type": "string", "minLength": 1 },
              "phone": { "type": "string", "minLength": 1 },
              "payment": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
